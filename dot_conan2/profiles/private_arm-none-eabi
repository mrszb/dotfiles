{% set tc = os.getenv("HOME") + "/x-tools/arm-gnu-toolchain-15.2.rel1-x86_64-arm-none-eabi" %}
{% set prefix = tc + "/bin/arm-none-eabi-" %}

# Base profile for the Arm GNU Toolchain 15.2.rel1 (arm-none-eabi) in ~/x-tools.
# Do not use directly for a build -- it sets no -mcpu. Include it from a
# per-target profile (see cortex-m4) that adds the MCU flags.

[settings]
os=baremetal
arch=armv7
compiler=gcc
compiler.version=15
compiler.cppstd=gnu17
compiler.libcxx=libstdc++11
build_type=Release

[buildenv]
CC={{ prefix }}gcc
CXX={{ prefix }}g++
AR={{ prefix }}ar
AS={{ prefix }}as
RANLIB={{ prefix }}ranlib
STRIP={{ prefix }}strip
OBJCOPY={{ prefix }}objcopy
OBJDUMP={{ prefix }}objdump
SIZE={{ prefix }}size

[conf]
tools.build:compiler_executables={"c": "{{ prefix }}gcc", "cpp": "{{ prefix }}g++", "asm": "{{ prefix }}gcc"}
tools.cmake.cmaketoolchain:system_name=Generic
tools.cmake.cmaketoolchain:system_processor=arm
