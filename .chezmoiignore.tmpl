# .chezmoiignore — per-platform exclusions (this file is itself a template)

{{ if eq .chezmoi.os "windows" -}}
# Native Windows has no bash — these would be written but never read.
.bashrc
.bashrc.d
.profile
.bash_profile
{{ else -}}
# Unix machines don't want the PowerShell profile.
Documents
{{ end -}}

{{ if not (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
# WSL-only module: harmless elsewhere (it self-guards on IS_WSL), but
# there is no reason to write it on Fedora or the Pis.
.bashrc.d/60-wsl
{{ end -}}
