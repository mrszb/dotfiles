# ~/.bashrc — universal, managed by chezmoi
# Works on Fedora (sources /etc/bashrc), Debian/Ubuntu/Pi OS (system
# /etc/bash.bashrc is sourced automatically), and WSL.

# If not running interactively, don't do anything
case $- in
	*i*) ;;
	*) return ;;
esac

# Fedora/RHEL system-wide config (Debian family has no such file; guard covers both)
[ -f /etc/bashrc ] && . /etc/bashrc

# History
HISTCONTROL=ignoreboth
shopt -s histappend
HISTSIZE=10000
HISTFILESIZE=20000

# Update LINES/COLUMNS after each command
shopt -s checkwinsize

# Color support for ls
if [ -x /usr/bin/dircolors ]; then
	test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
	alias ls='ls --color=auto'
	alias grep='grep --color=auto'
fi

# Programmable completion (Debian family; Fedora loads it via /etc/profile.d)
if ! shopt -oq posix; then
	if [ -f /usr/share/bash-completion/bash_completion ]; then
		. /usr/share/bash-completion/bash_completion
	elif [ -f /etc/bash_completion ]; then
		. /etc/bash_completion
	fi
fi

# User PATH additions (deduped; safe in nested shells)
for _p in "$HOME/bin" "$HOME/.local/bin"; do
	case ":$PATH:" in
		*":$_p:"*) ;;
		*) [ -d "$_p" ] && PATH="$_p:$PATH" ;;
	esac
done
unset _p
export PATH

# Rust
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Modular config — the whole point
if [ -d ~/.bashrc.d ]; then
	for rc in ~/.bashrc.d/*; do
		[ -f "$rc" ] && . "$rc"
	done
fi
unset rc
