# ~/.bashrc.d/30-platform — WSL vs native detection (managed by chezmoi)
# Runtime check: same file works on Fedora, Ubuntu, WSL, Pi.

if [[ "$(< /proc/sys/kernel/osrelease)" == *icrosoft* ]]; then
	export IS_WSL=1
	VERACRYPT='/mnt/c/Program Files/VeraCrypt/VeraCrypt.exe'
	BCOMP='/mnt/c/Program Files/Beyond Compare 5/bcomp.exe'

	# Beyond Compare, translating WSL paths to Windows paths
	diffui ()
	{
		"$BCOMP" "$(wslpath -aw "$1")" "$(wslpath -aw "$2")"
	}

	# Wrapper so `bcompare` works on WSL too (Windows binary is bcomp.exe)
	bcompare ()
	{
		"$BCOMP" "$@"
	}
else
	VERACRYPT=veracrypt
	BCOMP=bcompare

	diffui ()
	{
		command "$BCOMP" "$1" "$2"
	}
	# No bcompare wrapper here: the Linux RPM already provides /usr/bin/bcompare.
fi

# IMPORTANT: these must be FUNCTIONS, not aliases.
# Alias expansion is textual, so
#     alias vc="/mnt/c/Program Files/VeraCrypt/VeraCrypt.exe"
# word-splits on the space and tries to run "/mnt/c/Program". It looks
# correct when you inspect it with `alias vc`, but fails on execution.
# A function keeps "$VERACRYPT" quoted as one word.
vc ()
{
	"$VERACRYPT" "$@"
}
