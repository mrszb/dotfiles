# Extract any archive(s)
extract () {
	local archive
	for archive in "$@"; do
		if [ -f "$archive" ] ; then
			case $archive in
				*.tar.bz2)   tar xvjf "$archive"    ;;
				*.tar.gz)    tar xvzf "$archive"    ;;
				*.tar.xz)    tar xvJf "$archive"    ;;
				*.tar.zst)   tar --zstd -xvf "$archive" ;;
				*.bz2)       bunzip2 "$archive"     ;;
				*.rar)       unrar x "$archive"     ;;
				*.gz)        gunzip "$archive"      ;;
				*.tar)       tar xvf "$archive"     ;;
				*.tbz2)      tar xvjf "$archive"    ;;
				*.tgz)       tar xvzf "$archive"    ;;
				*.zip)       unzip "$archive"       ;;
				*.Z)         uncompress "$archive"  ;;
				*.7z)        7z x "$archive"        ;;
				*)           echo "don't know how to extract '$archive'..." ;;
			esac
		else
			echo "'$archive' is not a valid file!"
		fi
	done
}

# Search for text in all files in the current folder
ftext ()
{
	# -i case-insensitive, -I ignore binary, -H print filename,
	# -r recursive, -n line numbers
	grep -iIHrn --color=always "$1" . | less -r
}

# Current network information (iproute2, works on modern distros)
netinfo ()
{
	echo "--------------- Network Information ---------------"
	ip -brief -color addr show
	echo "---------------------------------------------------"
	ip route show default
	echo "---------------------------------------------------"
}

# IP address lookup
alias whatismyip='whatsmyip'
whatsmyip ()
{
	echo -n "Internal IP:  " ; hostname -I | awk '{print $1}'
	echo -n "External IPv4: " ; curl -4 -s --max-time 5 ifconfig.me ; echo
	echo -n "External IPv6: " ; curl -6 -s --max-time 5 ifconfig.me ; echo
}

# Find Raspberry Pi(s) on the local network
# (B8:27:EB = Pi 1-3 MAC prefix; DC:A6:32 and D8:3A:DD cover Pi 4/5)
findpi ()
{
	local localip
	localip=$(hostname -I | cut -d ' ' -f1)
	echo "local ip addr: $localip"
	echo "looking for Pi(s)"
	sudo nmap -sP "${localip}/24" | awk '/^Nmap/{ip=$NF}/B8:27:EB|DC:A6:32|D8:3A:DD/{print ip}'
}

# Show the current distribution (via os-release, no init-script archaeology):
distribution () { ( . /etc/os-release 2>/dev/null && echo "${ID:-unknown}" ) || echo unknown; }

# Show the current version of the operating system
ver ()
{
	[ -r /etc/os-release ] && grep PRETTY_NAME /etc/os-release | cut -d'"' -f2
	uname -srmo
}
