# ~/.bashrc.d/40-dev — dev tooling (managed by chezmoi)

# conan from its dedicated venv
alias conan='~/.venvs/conan/bin/conan'

# cmake variants — only define the ones that exist on this box
[ -x /snap/bin/cmake ]      && alias cmake-snap='/snap/bin/cmake'
[ -x /usr/bin/cmake ]       && alias cmake-apt='/usr/bin/cmake'
[ -x /usr/local/bin/cmake ] && alias cmake-local='/usr/local/bin/cmake'

# Cross toolchains: prepend every ~/x-tools/*/bin that exists
# (arm-none-eabi, avr-gcc, m68k-elf, whatever lands there next)
for d in "$HOME"/x-tools/*/bin; do
	[ -d "$d" ] || continue                 # glob didn't match anything
	case ":$PATH:" in
		*":$d:"*) ;;                        # already present (nested shell)
		*) PATH="$d:$PATH" ;;
	esac
done
unset d

# JetBrains Toolbox scripts — append, just convenience launchers
d="$HOME/.local/share/JetBrains/Toolbox/scripts"
case ":$PATH:" in
	*":$d:"*) ;;
	*) [ -d "$d" ] && PATH="$PATH:$d" ;;
esac
unset d

export PATH

# crosstool-NG build output (outside x-tools, still opt-in)
path_ct ()
{
	export PATH="$HOME/projects/m68k-toolchain/.crosstool/bin:$PATH"
}


# CUDA toolkit
if [ -d /usr/local/cuda/bin ]; then
	case ":$PATH:" in
		*":/usr/local/cuda/bin:"*) ;;
		*) PATH="/usr/local/cuda/bin:$PATH" ;;
	esac
	export PATH
fi
