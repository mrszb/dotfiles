# .chezmoiignore — per-platform exclusions (always treated as a template)
{{ if eq .chezmoi.os "windows" -}}
# Native Windows has no bash — these would be written but never read.
.bashrc
.bashrc.d
.profile
.bash_profile
{{ else -}}
# Unix machines don't want the PowerShell profile.
Documents
{{ end -}}

{{ if ne .chezmoi.os "windows" -}}
{{   if not (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
.bashrc.d/60-wsl
{{   end -}}
{{ end -}}

{{ if or (eq .chezmoi.hostname "pinas") (eq .chezmoi.hostname "pi5") -}}
.conan2/**
{{ end -}}
