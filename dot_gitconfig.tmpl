# ~/.gitconfig — managed by chezmoi (template)
# Shared settings live here; only diff/merge tool wiring is platform-specific.

[user]
	name = Marian Szabo
	email = mrszb@yahoo.com

[alias]
	hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
	unstage = reset HEAD --
	co = checkout
	ci = commit
	st = status
	br = branch
	type = cat-file -t
	dump = cat-file -p
	dt = difftool
	mt = mergetool
	last = log -1 HEAD --stat
	visual = !gitk --all&
	diffdir = difftool --dir-diff --no-symlinks
	diffbc = difftool --tool=BCompare
	diffp4 = difftool --tool=p4merge

[color]
	status = auto

[color "status"]
	added = green
	untracked = magenta
	deleted = red
	changed = cyan normal bold

[color "diff"]
	old = red normal bold
	new = green normal bold

[difftool]
	prompt = false
	keepTemporaries = false
	trustExitCode = false
	keepBackup = false

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[core]
	editor = code --wait
{{- if eq .chezmoi.os "windows" }}
	autocrlf = true
{{- else }}
	autocrlf = false
{{- end }}

[pull]
	rebase = false

[fetch]
	prune = false

[rebase]
	autoStash = false

[init]
	defaultBranch = main

[credential]
{{- if eq .chezmoi.os "windows" }}
	helper = manager
{{- else }}
	helper = store
{{- end }}

# ============================================================
# Platform-specific diff/merge tools
# ============================================================
{{ if eq .chezmoi.os "windows" -}}
# ---- Native Windows: direct .exe paths, no path translation ----
[diff]
	tool = p4merge

[merge]
	tool = p4merge

[difftool "p4merge"]
	path = C:/Program Files/Perforce/p4merge.exe

[mergetool "p4merge"]
	path = C:/Program Files/Perforce/p4merge.exe

[difftool "BCompare"]
	path = C:/Program Files/Beyond Compare 5/BComp.exe

[mergetool "BCompare"]
	path = C:/Program Files/Beyond Compare 5/BComp.exe
	trustExitCode = true

{{ else if (get .chezmoi.kernel "osrelease" | toString | lower | contains "microsoft") -}}
# ---- WSL: Windows-side GUI tools reached through wslpath ----
[diff]
	tool = p4merge

[merge]
	tool = p4merge

[difftool "p4merge"]
	cmd = /mnt/c/Program\\ Files/Perforce/p4merge.exe "$(wslpath -aw $LOCAL)" "$(wslpath -aw $REMOTE)"

[mergetool "p4merge"]
	cmd = /mnt/c/Program\\ Files/Perforce/p4merge.exe "$(wslpath -aw $BASE)" "$(wslpath -aw $LOCAL)" "$(wslpath -aw $REMOTE)" "$(wslpath -aw $MERGED)"
	trustExitCode = false

[difftool "BCompare"]
	cmd = /mnt/c/Program\\ Files/Beyond\\ Compare\\ 5/bcomp.exe "$(wslpath -aw $LOCAL)" "$(wslpath -aw $REMOTE)"

[mergetool "BCompare"]
	cmd = /mnt/c/Program\\ Files/Beyond\\ Compare\\ 5/bcomp.exe "$(wslpath -aw $BASE)" "$(wslpath -aw $LOCAL)" "$(wslpath -aw $REMOTE)" "$(wslpath -aw $MERGED)"

[safe]
	directory = %(prefix)///wsl.localhost/WLinux/home/maros/proj-wsl/scanfiles

{{ else -}}
# ---- Native Linux: meld as default (always present); BCompare on demand ----
# NOTE: the Linux Beyond Compare RPM ships only `bcompare`, not `bcomp`.
[diff]
	tool = meld

[merge]
	tool = meld

[difftool "BCompare"]
	cmd = bcompare "$LOCAL" "$REMOTE"

[mergetool "BCompare"]
	cmd = bcompare "$BASE" "$LOCAL" "$REMOTE" "$MERGED"
{{ end -}}
