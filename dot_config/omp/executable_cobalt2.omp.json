{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#44FFB1",
          "foreground": "#000000",
          "leading_diamond": "",
          "trailing_diamond": "",
          "style": "diamond",
          "template": "  {{ .Env }} ",
          "type": "conda",
          "options": {
            "display_default": true
          }
        },        
        {
          "background": "#1478DB",
          "foreground": "#000000",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\uE0B0",
          "options": {
            "style": "full"
          },
          "style": "diamond",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#3AD900",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FFC600{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#FFCC80{{ end }}",
            "{{ if gt .Ahead 0 }}#B388FF{{ end }}",
            "{{ if gt .Behind 0 }}#B388FF{{ end }}"
          ],
          "foreground": "#000000",
          "leading_diamond": "<transparent,background>\uE0B0</>",
          "trailing_diamond": "\ue0b4",
          "options": {
            "fetch_status": true
          },
          "style": "diamond",
          "template": " {{ .HEAD }}{{ if .Staging.Changed }}<#FF6F00> \uf046 {{ .Staging.String }}</>{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        },
        {
          "type": "python",
          "style": "diamond",
          "leading_diamond": "<transparent,background></>",
          "trailing_diamond": "",
          "foreground": "#000000",
          "background": "#906cff",
          "background_templates": [
            "{{ if .Env.CONDA_DEFAULT_ENV }}#44FFB1{{ end }}"
          ],
          "template": "  {{ .Full }}{{ if .Venv }}  {{ .Venv }}{{ end }} ",
          "options": {
            "fetch_virtual_env": true
          }
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
